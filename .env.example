# Copy this file to .env and fill in the values.
# How many top stories to pull per run (the API returns up to 500)
HN_TOP_N=100

# Databricks Free Edition (leave blank to skip the upload step)
# Host looks like: https://<your-workspace>.cloud.databricks.com
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_VOLUME_PATH=/Volumes/workspace/hn/landing/silver
# Optional: ID of a Databricks job that runs the notebook; Airflow will trigger it after upload
DATABRICKS_JOB_ID=
